+    state = {
+        "prepared": prepared,
+        "num_experts": num_experts,
+        "hidden": hidden,
+        "intermediate": intermediate,
+        "bits": bits,
+        "swiglu_limit": swiglu_limit,
+        "device": base.device,
+        "buffers": {},
+        "blocks": {},
+        "scratch": {},
+        # Keep every table alive: prepared holds only views/pointers into them.
+        "keepalive": (
+            base,
+            w2,
+            gate_suh,
+            up_suh,
+            down_svh,
+            intermediate_rotations,
+        ),
+        "error": None,
+    }
