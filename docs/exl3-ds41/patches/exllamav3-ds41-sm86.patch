diff --git a/exllamav3/exllamav3_ext/quant/coop_autotune.cu b/exllamav3/exllamav3_ext/quant/coop_autotune.cu
index cd67ce53..72bc958d 100644
--- a/exllamav3/exllamav3_ext/quant/coop_autotune.cu
+++ b/exllamav3/exllamav3_ext/quant/coop_autotune.cu
@@ -677,6 +677,38 @@ CoopAutotuneLaunch CoopKernelAutotuner::launch
         return launch_config;
     }
 
+    // CUDA graph capture cannot measure candidates: cudaStreamSynchronize / cudaEventSynchronize
+    // are illegal on a capturing stream. Use a deterministic full-occupancy launch instead, so the
+    // same kernel is baked into the graph. It is not recorded in the caches, so eager calls with
+    // the same shape still get autotuned normally.
+    cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+    if (cudaStreamIsCapturing(stream, &capture_status) == cudaSuccess &&
+        capture_status != cudaStreamCaptureStatusNone)
+    {
+        const CoopAutotuneCandidate& base = candidates.front();
+        int total_sms = base.total_sms > 0 ? base.total_sms : base.max_num_sms;
+        int max_concurrency = MAX(base.max_concurrency, 1);
+        launch_config =
+        {
+            base.kernel,
+            base.block_dim,
+            base.max_num_sms,
+            MAX(MIN(total_sms / base.max_num_sms, max_concurrency), 1),
+            base.tag
+        };
+        set_kernel_attr_once(launch_config.kernel, smem);
+        cuda_check(cudaLaunchCooperativeKernel
+        (
+            launch_config.kernel,
+            dim3(launch_config.num_sms, 1, launch_config.concurrency),
+            launch_config.block_dim,
+            kernel_args,
+            smem,
+            stream
+        ));
+        return launch_config;
+    }
+
     {
         launch_config = tune(candidates, kernel_args, smem, stream, numel_B);
         auto inserted = launch_cache.emplace(salted_hash, launch_config);
